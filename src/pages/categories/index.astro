---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPill from '../../components/CategoryPill.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  const category = post.data.category;
  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---

<BaseLayout title="分类" description="按分类浏览文章">
  <h1 class="page-title">分类</h1>
  <p class="page-description">共 {categories.length} 个分类</p>
  {
    categories.length > 0 ? (
      <div>
        {categories.map(([category, count]) => <CategoryPill category={category} count={count} />)}
      </div>
    ) : (
      <div class="empty">还没有分类。</div>
    )
  }
</BaseLayout>
