---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---

<BaseLayout title="标签" description="按标签浏览文章">
  <h1 class="page-title">标签</h1>
  <p class="page-description">共 {tags.length} 个标签</p>
  {
    tags.length > 0 ? (
      <div class="tags" style="gap: 0.75rem">
        {tags.map(([tag, count]) => <TagPill tag={tag} count={count} />)}
      </div>
    ) : (
      <div class="empty">还没有标签。</div>
    )
  }
</BaseLayout>
