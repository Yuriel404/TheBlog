---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="项目" description="我的开源项目与作品">
  <h1 class="page-title">项目</h1>
  <p class="page-description">一些开源项目与作品</p>
  {
    projects.length > 0 ? (
      <div class="grid">
        {projects.map((project) => (
          <a class="card" href={project.url} target="_blank" rel="noopener">
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            {project.language && (
              <p style="margin-top: 0.5rem; color: var(--primary)">
                {project.language}
              </p>
            )}
          </a>
        ))}
      </div>
    ) : (
      <div class="empty">还没有项目。</div>
    )
  }
</BaseLayout>
