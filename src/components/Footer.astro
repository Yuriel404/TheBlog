---
import { siteConfig } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <span>© {year} {siteConfig.author}</span>
    <span>
      Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      <a href="/rss.xml" style="margin-left: 0.75rem">RSS</a>
      {siteConfig.social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" style="margin-left: 0.75rem">{s.title}</a>
      ))}
    </span>
  </div>
</footer>
