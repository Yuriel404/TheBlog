---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const prevHref = currentPage > 1 ? (currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`) : null;
const nextHref = currentPage < totalPages ? `/blog/page/${currentPage + 1}` : null;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="分页">
      {prevHref ? <a class="chip" href={prevHref}>← 上一页</a> : <span class="chip" aria-disabled="true">← 上一页</span>}
      <span class="chip" aria-current="page">{currentPage} / {totalPages}</span>
      {nextHref ? <a class="chip" href={nextHref}>下一页 →</a> : <span class="chip" aria-disabled="true">下一页 →</span>}
    </nav>
  )
}
