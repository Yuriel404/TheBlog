      <path d="M11 12 L13 12 L12 14 Z" fill="#f59e0b"/>
      <ellipse cx="9" cy="21" rx="2" ry="1" fill="#f59e0b"/>
      <ellipse cx="15" cy="21" rx="2" ry="1" fill="#f59e0b"/>
    </svg>
  )
}

{
  name === '网易云音乐' && (
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
    </svg>
  )
}
