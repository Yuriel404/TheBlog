}

{
  name === 'QQ' && (
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <ellipse cx="12" cy="14" rx="7" ry="8" fill="currentColor"/>
      <ellipse cx="12" cy="16" rx="4.5" ry="5.5" fill="#fff"/>
      <circle cx="9.5" cy="10" r="1.6" fill="#fff"/>
      <circle cx="14.5" cy="10" r="1.6" fill="#fff"/>
