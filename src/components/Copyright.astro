---
import { siteConfig } from '../data/site';

interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
const postUrl = new URL(Astro.url.pathname, siteConfig.site);
---

<aside class="copyright">
  <p>
    <strong>本文作者：</strong>{siteConfig.author}
  </p>
  <p>
    <strong>本文链接：</strong><a class="copyright-url" href={postUrl} title={postUrl.toString()}>{postUrl}</a>
  </p>
  <p>
    <strong>版权声明：</strong>采用<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> 许可协议。转载请注明出处。
  </p>
</aside>
