---
import { siteConfig } from '../data/site';

interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
const postUrl = new URL(Astro.url.pathname, siteConfig.site);
---

<aside class="copyright">
  <p>
    <strong>版权声明：</strong>
    本文由 <a href="/about">{siteConfig.author}</a> 发布于 {date.getFullYear()} 年，
    采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> 许可协议。
  </p>
  <p>
    原文链接：<a href={postUrl}>{postUrl}</a>
  </p>
  <p>转载请注明出处。</p>
</aside>
