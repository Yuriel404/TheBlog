---
interface Props {
  density?: "low" | "medium" | "high";
  color?: string;
  radius?: number;
  revealOn?: "hover" | "click";
  duration?: number;
  disabled?: boolean;
}

const {
  density = "medium",
  color = "#000000",
  radius = 0.7,
  revealOn = "hover",
  duration = 300,
  disabled = false,
} = Astro.props;
---

<span
  class:list={["particle-mask", { "particle-mask--disabled": disabled }]}
  data-reveal={revealOn}
  data-density={density}
  style={`--pm-duration: ${duration}ms; --pm-color: ${color}; --pm-radius: ${radius}px;`}
>
  <span class="particle-mask-content">
    <slot />
  </span>
  <canvas class="particle-mask-canvas" aria-hidden="true"></canvas>
  <script is:inline>
    (() => {
      const root = document.currentScript?.parentElement;
      if (!root || !root.classList.contains("particle-mask")) return;

      const canvas = root.querySelector(".particle-mask-canvas");
      if (!canvas) return;

      const disabled = root.classList.contains("particle-mask--disabled");
      const revealOn = root.dataset.reveal || "hover";
      const density = root.dataset.density || "medium";
      const color = getComputedStyle(root).getPropertyValue("--pm-color").trim() || "#ffffff";
      const radius = parseFloat(getComputedStyle(root).getPropertyValue("--pm-radius")) || 1;

      const ctx = canvas.getContext("2d");
      let particles = [];
      let width = 0;
      let height = 0;
      let raf = 0;

      function getDensityFactor() {
        if (density === "low") return 30;
        if (density === "high") return 10;
        return 15;
      }

      function resize() {
        const rect = root.getBoundingClientRect();
        const ratio = 1 //Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        canvas.width = Math.max(1, Math.floor(width * ratio));
        canvas.height = Math.max(1, Math.floor(height * ratio));
        canvas.style.width = width + "px";
        canvas.style.height = height + "px";
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

        const count = Math.max(60, Math.min(30000, Math.floor((width * height) / getDensityFactor())));
        const speed = 0.08;
        particles = Array.from({ length: count }, () => {
          const angle = Math.random() * Math.PI * 2;
          return {
            x: Math.random() * width,
            y: Math.random() * height,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            r: radius,
          };
        });
      }

      function update() {
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < -p.r) {
            p.x = width + p.r;
            p.y = Math.random() * height;
          } else if (p.x > width + p.r) {
            p.x = -p.r;
            p.y = Math.random() * height;
          }

          if (p.y < -p.r) {
            p.y = height + p.r;
            p.x = Math.random() * width;
          } else if (p.y > height + p.r) {
            p.y = -p.r;
            p.x = Math.random() * width;
          }
        }
      }

      function draw() {
        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = color;
        for (const p of particles) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function frame() {
        update();
        draw();
        raf = requestAnimationFrame(frame);
      }

      function reveal() {
        root.classList.add("is-revealed");
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }

      function hide() {
        root.classList.remove("is-revealed");
        if (!raf) {
          raf = requestAnimationFrame(frame);
        }
      }

      if (!disabled) {
        if (revealOn === "click") {
          root.addEventListener("click", () => {
            if (root.classList.contains("is-revealed")) {
              hide();
            } else {
              reveal();
            }
          });
        } else {
          root.addEventListener("mouseenter", reveal);
          root.addEventListener("mouseleave", hide);
          root.addEventListener("touchstart", reveal, { passive: true });
          root.addEventListener("touchend", hide, { passive: true });
          root.addEventListener("touchcancel", hide, { passive: true });
        }
      }

      function init() {
        resize();
        raf = requestAnimationFrame(frame);
        window.addEventListener("resize", () => {
          resize();
        });
      }

      init();
    })();
  </script>
</span>

<style>
  .particle-mask {
    position: relative;
    display: inline-block;
    max-width: 100%;
    cursor: default;
  }

  .particle-mask-content {
    transition: opacity var(--pm-duration) ease;
  }

  .particle-mask:not(.is-revealed) .particle-mask-content {
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  .particle-mask.is-revealed .particle-mask-content {
    opacity: 1;
    pointer-events: auto;
  }

  .particle-mask-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    transition: opacity var(--pm-duration) ease;
  }

  .particle-mask.is-revealed .particle-mask-canvas {
    opacity: 0;
  }

  .particle-mask--disabled .particle-mask-canvas {
    display: none;
  }

  .particle-mask--disabled .particle-mask-content {
    opacity: 1;
    pointer-events: auto;
    user-select: auto;
  }
</style>
